        <mxCell id="Ffss81v8E6SzfuyoDxWx-77" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Comic Sans MS;fontSize=15;fontStyle=1" value="&lt;span&gt;&lt;font&gt;buy a voucher&lt;/font&gt;&lt;/span&gt;" vertex="1">
